# Copy this file to .dev.vars for local development
# .dev.vars is gitignored and will be used by wrangler dev

# Admin Secret (for local testing)
ADMIN_SECRET=hanzi-local-dev-secret-12345

# JWT Secret (used to sign/verify tokens)
JWT_SECRET=super-long-random-jwt-secret-change-me
# Optional: override token lifetime
JWT_MAX_AGE=7d

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-actual-key-here

# Optional: Use a different OpenAI endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional defaults
DEFAULT_AI_MODEL=gpt-4o-mini
MAX_REQUESTS_PER_DAY=10
MAX_TOKENS_PER_DAY=5000

